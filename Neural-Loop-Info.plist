<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sanjeevhalyal.Neural-Loop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>neural-loop</string>
			</array>
		</dict>
	</array>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app uses the microphone to capture your speech for transcription.</string>
	<key>NSCameraUsageDescription</key>
	<string>Neural Loop uses the camera to send captured images to Codex for visual understanding.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Neural Loop writes water logged from your water habit to Apple Health.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Neural Loop uses Reminders access to create and show Genesys work notes.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app sends audio to Apple speech recognition to turn your speech into text.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
